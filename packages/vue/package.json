{
  "name": "@yatmo/vue",
  "version": "1.0.0",
  "description": "Add real estate maps, points of interest and neighbourhood data to Vue and Nuxt applications: YatmoMap, YatmoPois and YatmoNeighbourhoodText components and composables for property pages, with server rendering support. The official Vue SDK for Yatmo.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "yatmo",
    "vue",
    "vue3",
    "nuxt",
    "vue-components",
    "real-estate",
    "proptech",
    "map",
    "poi",
    "points-of-interest",
    "neighbourhood",
    "property",
    "listing",
    "isochrone",
    "seo"
  ],
  "author": "Yatmo (https://yatmo.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yatmo/yatmo-sdk-js.git",
    "directory": "packages/vue"
  },
  "homepage": "https://documentation.yatmo.com/api/javascript-sdk",
  "bugs": {
    "url": "https://github.com/Yatmo/yatmo-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@yatmo/maps": "^1.0.1",
    "@yatmo/sdk": "^1.0.1"
  }
}
